---
---

<nav class="sticky top-0 left-0 z-10 bg-blue-600/95 backdrop-blur-sm w-full text-white flex flex-wrap items-center justify-between py-3 px-6 shadow-md" role="navigation">
  <a class="flex items-center gap-2" href="#top">
    <span class="text-2xl font-bold">Yoshihiko Kato</span>
    <span class="hidden sm:inline text-sm opacity-75">a.k.a. discord4415</span>
  </a>
  <button
    id="menu-toggle"
    class="md:hidden p-2 rounded hover:bg-blue-700 transition-colors"
    type="button"
    aria-label="メニューを開閉"
    aria-expanded="false"
    aria-controls="menu"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
  <ul class="hidden md:flex items-center gap-1 w-full md:w-auto flex-col md:flex-row bg-blue-600 md:bg-transparent" id="menu">
    <li><a class="hover:bg-blue-700 rounded px-3 py-3 md:py-2 transition-colors block" href="#it">興味</a></li>
    <li><a class="hover:bg-blue-700 rounded px-3 py-3 md:py-2 transition-colors block" href="#wh">職歴</a></li>
    <li><a class="hover:bg-blue-700 rounded px-3 py-3 md:py-2 transition-colors block" href="#kb">研究</a></li>
    <li><a class="hover:bg-blue-700 rounded px-3 py-3 md:py-2 transition-colors block" href="#ks">趣味</a></li>
    <li><a class="hover:bg-blue-700 rounded px-3 py-3 md:py-2 transition-colors block" href="#jr">受賞歴</a></li>
    <li><a class="hover:bg-blue-700 rounded px-3 py-3 md:py-2 transition-colors block" href="#works">制作物</a></li>
  </ul>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      if (menu.classList.contains('hidden') && !window.matchMedia('(min-width: 768px)').matches) {
        menu.classList.remove('hidden');
        menu.classList.add('flex');
        toggle.setAttribute('aria-expanded', 'true');
      } else if (!window.matchMedia('(min-width: 768px)').matches) {
        menu.classList.add('hidden');
        menu.classList.remove('flex');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });

    // メニューリンクをクリックしたらメニューを閉じる
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (!window.matchMedia('(min-width: 768px)').matches) {
          menu.classList.add('hidden');
          menu.classList.remove('flex');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    });
  }
</script>
